# RC16 maintenance note:
# This vendored upstream Docker s390x development image is not used by Rancher
# 1.6 builds. The historical file pinned obsolete distro/toolchain packages, so
# the maintained fork keeps a safe placeholder instead of publishing stale build
# instructions in public source.
FROM ubuntu:26.04

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates bash \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

CMD ["/bin/bash"]
